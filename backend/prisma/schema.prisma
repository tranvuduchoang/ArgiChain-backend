// Prisma schema for AgriChain unified data layer
// Generated by Codex refactor - keep synchronized with backend services

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  BUYER
  SUPPLIER
  ADMIN
}

enum KycStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ListingStatus {
  DRAFT
  ACTIVE
  PAUSED
  ARCHIVED
}

enum PricingModel {
  FIXED
  TIERED
  AUCTION
}

enum InventoryStatus {
  AVAILABLE
  RESERVED
  SOLD_OUT
  DAMAGED
  EXPIRED
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PAID
  IN_FULFILLMENT
  SHIPPED
  DELIVERED
  CANCELLED
  REFUNDED
}

enum PaymentMethod {
  CRYPTO
  FIAT
}

enum PaymentStatus {
  PENDING
  CONFIRMED
  FAILED
  REFUNDED
}

enum LoyaltyTransactionType {
  EARN
  REDEEM
  ADJUST
}

enum LoyaltyTransactionSource {
  ORDER
  MANUAL
  BONUS
}

enum BrandMemberRole {
  OWNER
  MANAGER
  STAFF
}

enum BrandMemberStatus {
  INVITED
  ACTIVE
  INACTIVE
}

enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

enum TokenTransferType {
  MINT
  TRANSFER
  BURN
  REDEEM
}

model User {
  id             String         @id @default(cuid())
  email          String         @unique
  username       String         @unique
  walletAddress  String         @unique
  role           UserRole       @default(BUYER)
  avatar         String?
  phone          String?
  address        String?
  isSupplier     Boolean        @default(false)
  isVerified     Boolean        @default(false)
  kycStatus      KycStatus      @default(PENDING)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  supplierProfile Supplier?
  brandMemberships BrandMember[]
  reviews          Review[]
  orders           Order[]      @relation("UserOrders")
  loyaltyLedger    LoyaltyLedger[]
  nftHoldings      NFT[]
  bids             Bid[]

  @@map("users")
}

model Supplier {
  id              String                 @id @default(cuid())
  userId          String                 @unique
  businessName    String
  slug            String                 @unique
  description     String?
  logo            String?
  coverImage      String?
  website         String?
  location        String?
  contactEmail    String?
  contactPhone    String?
  socialLinks     Json?
  rating          Float                  @default(0)
  totalSales      Int                    @default(0)
  isActive        Boolean                @default(true)
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt

  user             User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  members          BrandMember[]
  products         Product[]
  loyaltyPrograms  LoyaltyProgram[]
  loyaltyLedgerEntries LoyaltyLedger[]
  reviews          Review[]
  orders           Order[]                @relation("SupplierOrders")
  auctions         Auction[]
  contractTemplates SmartContractTemplate[]

  @@map("suppliers")
}

model BrandMember {
  id          String            @id @default(cuid())
  supplierId  String
  userId      String
  role        BrandMemberRole   @default(STAFF)
  status      BrandMemberStatus @default(INVITED)
  invitedAt   DateTime          @default(now())
  respondedAt DateTime?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  supplier Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([supplierId, userId])
  @@map("brand_members")
}

model Product {
  id                  String        @id @default(cuid())
  supplierId          String
  name                String
  description         String
  category            String
  tags                String[]
  pricingModel        PricingModel  @default(FIXED)
  pricePerUnit        Decimal       @db.Decimal(18, 4)
  currency            String        @default("MATIC")
  totalSupply         Int
  availableSupply     Int
  unit                String
  metadataCid         String?
  metadataUrl         String?
  contractAddress     String?
  nftTokenId          String?
  mintTxHash          String?
  mintedAt            DateTime?
  harvestDate         DateTime?
  expiryDate          DateTime?
  qualityCertifications String[]
  storageConditions   String?
  images              String[]
  isOrganic           Boolean       @default(false)
  isActive            Boolean       @default(true)
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  supplier            Supplier      @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  inventoryLots       InventoryLot[]
  listings            MarketplaceListing[]
  reviews             Review[]
  orderItems          OrderItem[]
  productTokens       ProductToken[]
  auctions            Auction[]

  @@map("products")
}

model InventoryLot {
  id              String          @id @default(cuid())
  productId       String
  identifier      String?
  quantity        Int
  reservedQuantity Int            @default(0)
  unitCost        Decimal?        @db.Decimal(18, 4)
  harvestDate     DateTime?
  bestBeforeDate  DateTime?
  storageLocation String?
  qualityDocuments String[]
  status          InventoryStatus @default(AVAILABLE)
  notes           String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("inventory_lots")
}

model MarketplaceListing {
  id                String         @id @default(cuid())
  productId         String
  title             String
  slug              String         @unique
  shortDescription  String?
  status            ListingStatus  @default(DRAFT)
  isFeatured        Boolean        @default(false)
  searchTags        String[]
  minOrderQuantity  Int            @default(1)
  maxOrderQuantity  Int?
  leadTimeDays      Int?           @default(2)
  publishedAt       DateTime?
  archivedAt        DateTime?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId])
  @@map("marketplace_listings")
}

model Review {
  id          String       @id @default(cuid())
  userId      String
  productId   String?
  supplierId  String
  orderId     String?
  rating      Int
  comment     String?
  images      String[]
  status      ReviewStatus @default(PENDING)
  moderatedBy String?
  moderatedAt DateTime?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  product   Product?  @relation(fields: [productId], references: [id], onDelete: SetNull)
  supplier  Supplier  @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  order     Order?    @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@unique([userId, productId, orderId])
  @@map("reviews")
}

model Order {
  id              String       @id @default(cuid())
  orderNumber     String       @unique
  userId          String
  supplierId      String
  status          OrderStatus  @default(PENDING)
  paymentMethod   PaymentMethod
  paymentStatus   PaymentStatus @default(PENDING)
  subtotalAmount  Decimal       @db.Decimal(18, 4)
  feeAmount       Decimal       @db.Decimal(18, 4)
  totalAmount     Decimal       @db.Decimal(18, 4)
  currency        String        @default("MATIC")
  transactionHash String?
  deliveryAddress String
  deliveryMethod  String
  expectedFulfillment DateTime?
  fulfilledAt     DateTime?
  cancelledAt     DateTime?
  cancelReason    String?
  notes           String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  user     User      @relation("UserOrders", fields: [userId], references: [id], onDelete: Cascade)
  supplier Supplier  @relation("SupplierOrders", fields: [supplierId], references: [id], onDelete: Cascade)
  items    OrderItem[]
  payment  PaymentReceipt?
  reviews  Review[]

  @@map("orders")
}

model OrderItem {
  id             String      @id @default(cuid())
  orderId        String
  productId      String
  productTokenId String?
  quantity       Int
  unitPrice      Decimal     @db.Decimal(18, 4)
  totalPrice     Decimal     @db.Decimal(18, 4)
  metadata       Json?
  createdAt      DateTime    @default(now())

  order        Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product      Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  productToken ProductToken? @relation(fields: [productTokenId], references: [id], onDelete: SetNull)

  @@map("order_items")
}

model PaymentReceipt {
  id              String         @id @default(cuid())
  orderId         String         @unique
  chainId         Int?
  paymentMethod   PaymentMethod
  status          PaymentStatus  @default(PENDING)
  transactionHash String?
  payerAddress    String?
  receiverAddress String?
  amount          Decimal        @db.Decimal(18, 4)
  currency        String         @default("MATIC")
  metadata        Json?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@map("payment_receipts")
}

model NFT {
  id             String        @id @default(cuid())
  userId         String
  productTokenId String
  quantity       Int           @default(0)
  metadata       Json
  isUsed         Boolean       @default(false)
  lastSyncedAt   DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  productToken ProductToken @relation(fields: [productTokenId], references: [id], onDelete: Cascade)

  @@unique([userId, productTokenId])
  @@map("nfts")
}

model LoyaltyProgram {
  id                   String    @id @default(cuid())
  supplierId           String    @unique
  name                 String
  description          String?
  earnRatePerToken     Decimal   @db.Decimal(18, 4)
  redeemValuePerPoint  Decimal   @db.Decimal(18, 4)
  tierConfiguration    Json?
  expirationDays       Int?
  isActive             Boolean   @default(true)
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  supplier        Supplier        @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  ledgerEntries   LoyaltyLedger[]

  @@map("loyalty_programs")
}

model LoyaltyLedger {
  id             String                    @id @default(cuid())
  userId         String
  supplierId     String
  loyaltyProgramId String
  type           LoyaltyTransactionType    @default(EARN)
  source         LoyaltyTransactionSource  @default(ORDER)
  points         Int
  balanceAfter   Int
  referenceId    String?
  notes          String?
  occurredAt     DateTime                  @default(now())
  expiresAt      DateTime?
  createdAt      DateTime                  @default(now())

  user     User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  supplier Supplier        @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  program  LoyaltyProgram  @relation(fields: [loyaltyProgramId], references: [id], onDelete: Cascade)

  @@index([userId, supplierId])
  @@map("loyalty_ledger")
}

model Auction {
  id           String    @id @default(cuid())
  productId    String
  supplierId   String
  startPrice   Decimal   @db.Decimal(18, 4)
  currentPrice Decimal   @db.Decimal(18, 4)
  reservePrice Decimal?  @db.Decimal(18, 4)
  buyNowPrice  Decimal?  @db.Decimal(18, 4)
  startTime    DateTime
  endTime      DateTime
  isActive     Boolean   @default(true)
  winnerId     String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  product  Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  supplier Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  bids     Bid[]

  @@map("auctions")
}

model Bid {
  id        String   @id @default(cuid())
  auctionId String
  userId    String
  amount    Decimal  @db.Decimal(18, 4)
  status    String   @default("PENDING")
  createdAt DateTime @default(now())

  auction Auction @relation(fields: [auctionId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("bids")
}

model SmartContractTemplate {
  id              String    @id @default(cuid())
  supplierId      String
  name            String
  description     String?
  contractType    String     @default("ERC1155")
  contractAddress String     @unique
  networkChainId  Int
  abi             Json
  bytecode        String?
  version         String
  deployedAt      DateTime   @default(now())
  isActive        Boolean    @default(true)
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  supplier      Supplier      @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  productTokens ProductToken[]

  @@map("smart_contract_templates")
}

model ProductToken {
  id               String    @id @default(cuid())
  productId        String
  templateId       String?
  tokenId          String
  contractAddress  String
  totalMinted      Int
  metadataCid      String?
  mintTxHash       String?
  mintedAt         DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  product   Product              @relation(fields: [productId], references: [id], onDelete: Cascade)
  template  SmartContractTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  orderItems OrderItem[]
  tokenTransfers TokenTransfer[]
  nftHoldings NFT[]

  @@unique([contractAddress, tokenId])
  @@map("product_tokens")
}

model TokenTransfer {
  id             String            @id @default(cuid())
  productTokenId String
  fromAddress    String?
  toAddress      String?
  quantity       Int
  txHash         String
  chainId        Int
  type           TokenTransferType @default(TRANSFER)
  occurredAt     DateTime          @default(now())
  metadata       Json?
  createdAt      DateTime          @default(now())

  productToken ProductToken @relation(fields: [productTokenId], references: [id], onDelete: Cascade)

  @@index([txHash])
  @@map("token_transfers")
}

model OnChainEventLog {
  id              String   @id @default(cuid())
  contractAddress String
  chainId         Int
  eventName       String
  txHash          String
  blockNumber     BigInt?
  payload         Json
  processed       Boolean  @default(false)
  createdAt       DateTime @default(now())

  @@index([contractAddress, chainId])
  @@map("onchain_event_logs")
}

